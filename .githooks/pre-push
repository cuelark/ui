#!/bin/sh
# Maintainers only: refuse to push any commit whose author or committer is not Cuelark.
expected="Cuelark <contact@cuelark.com>"
zero=0000000000000000000000000000000000000000
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  bad=$(git log --format='%h %an <%ae> / %cn <%ce>' "$range" | grep -v -F "$expected / $expected")
  if [ -n "$bad" ]; then
    echo "✗ refusing to push commits not authored and committed by $expected:" >&2
    echo "$bad" >&2
    exit 1
  fi
done
