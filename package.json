{
  "name": "@cuelark/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Animated, accessible React components for shadcn/ui: an AI agent UI kit, GSAP motion, live theming and 50,000+ icons.",
  "author": "Cuelark <contact@cuelark.com>",
  "license": "MIT",
  "homepage": "https://ui.cuelark.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuelark/ui.git"
  },
  "bugs": {
    "url": "https://github.com/cuelark/ui/issues"
  },
  "keywords": [
    "shadcn",
    "shadcn-ui",
    "registry",
    "react",
    "components",
    "tailwindcss",
    "radix-ui",
    "gsap",
    "animation",
    "ai",
    "agents",
    "icons"
  ],
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "pnpm icons:build && pnpm registry:build && vite dev",
    "build": "pnpm icons:build && pnpm registry:build && vite build",
    "preview": "vite preview",
    "registry:build": "tsx scripts/registry.ts && shadcn build -o public/r",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test test/*.test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "alchemy": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-strip-types\" alchemy",
    "plan:preview": "tsx scripts/deploy.ts preview --plan",
    "deploy:preview": "tsx scripts/deploy.ts preview",
    "deploy:prod": "tsx scripts/deploy.ts prod",
    "deploy:icons": "tsx scripts/deploy-icons.ts",
    "icons:build": "tsx scripts/icons.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@gsap/react": "2.1.2",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "gsap": "3.15.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.59.0",
    "radix-ui": "1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.0",
    "@cloudflare/workers-types": "5.20260724.1",
    "@effect/platform-node": "4.0.2",
    "@effect/platform-node-shared": "4.0.2",
    "@eslint/js": "9.39.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "alchemy": "2.0.0-beta.81",
    "effect": "4.0.2",
    "eslint": "9.39.4",
    "shadcn": "4.22.1",
    "shiki": "4.5.0",
    "tailwindcss": "4.2.2",
    "tsx": "4.23.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "wrangler": "4.126.0"
  }
}
