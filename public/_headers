# Cloudflare static-asset headers. HTML keeps the platform default (revalidate on every visit) so a deploy is live
# at once; everything below is either content-hashed or safe to serve slightly stale.

# Vite output: the file name carries its content hash, so it never changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# shadcn registry files and icon set indexes: change only on deploy.
/r/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *

/icons/*.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/sitemap*.xml
  Cache-Control: public, max-age=3600

/llms*.txt
  Cache-Control: public, max-age=3600

/favicon.*
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
